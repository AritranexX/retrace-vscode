{
  "name": "retrace-vscode",
  "displayName": "Retrace",
  "description": "Local-first VS Code extension that tracks developer workflow context, active time per file, line changes, and cursor bookmarks.",
  "version": "0.0.1",
  "publisher": "retrace",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "retrace-sidebar-view",
          "title": "Retrace",
          "icon": "$(history)"
        }
      ]
    },
    "views": {
      "retrace-sidebar-view": [
        {
          "type": "webview",
          "id": "retrace.sidebarView",
          "name": "Retrace Timeline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build:webview": "vite build",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:sql.js --format=cjs --platform=node && cp node_modules/sql.js/dist/sql-wasm.wasm dist/",
    "build": "npm run build:webview && npm run build:extension",
    "package": "npx vsce package --no-dependencies",
    "test": "vitest run"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "clsx": "^2.1.0",
    "dagre": "^0.8.5",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.10.3",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.3.0"
  }
}